config MONITOR_DISPATCHER_STACK_SIZE
	int "Dispatcher thread stack size (bytes)"
	default 8192

config MONITOR_WORKQ_PRIORITY
	int "Collector work queue priority"
	default 8

config MONITOR_ANALYZER_PRIORITY
	int "Analyzer thread priority"
	default 9

config MONITOR_DISPATCHER_PRIORITY
	int "Dispatcher thread priority"
	default 11

# --- Stack Overflow Detection ---
config RUNTIME_MONITOR_STACK_OVERFLOW
	bool "Stack overflow detection via fatal error hook"
	default y
	help
	  Override Zephyr's weak k_sys_fatal_error_handler to intercept
	  K_ERR_STACK_CHK_FAIL events — fired by stack canary failures
	  (-fstack-protector via STACK_CANARIES) or by MPU-detected stack
	  guard violations when CONFIG_HW_STACK_PROTECTION=y. The handler
	  best-effort publishes a THREAT_STACK_OVERFLOW alert on the zbus
	  alert_chan (K_NO_WAIT — fault context cannot block) before
	  delegating to k_fatal_halt(). Enable when you want the runtime
	  to surface stack-overrun threats to the dispatcher in addition
	  to halting the system.

	  This switch only enables the override; it does NOT enable the
	  canary itself. STACK_CANARIES is a choice symbol inside an
	  optional Kconfig choice (siblings: STACK_CANARIES_STRONG,
	  STACK_CANARIES_ALL, STACK_CANARIES_EXPLICIT) so it cannot be
	  `select`-ed from a parent. The integrator must set one of those
	  in their .conf and provide entropy
	  (CONFIG_ENTROPY_GENERATOR=y on a board with HW RNG, or
	  CONFIG_TEST_RANDOM_GENERATOR=y for QEMU/test builds).

# --- Syscall Hooks (ADR-004) ---
config RUNTIME_MONITOR_SYSCALL_HOOKS
	bool "Synchronous syscall interception (ADR-004)"
	depends on ARM
	select LLEXT
	help
	  Enable --wrap based syscall interception with an LLEXT
	  hot-loadable hook module.  When enabled, z_impl_k_thread_priority_set
	  is dispatched through a global vtable that LLEXT modules can patch
	  at runtime.

	  Cortex-M only. The --wrap link mechanism and EXPORT_SYMBOL plumbing
	  are cross-arch, but LLEXT module .text lives in RAM — the integrator
	  must ensure that RAM is executable on their target. See the lib-level
	  contract described in agent.c (chosen { zephyr,llext-heap }) and the
	  platform note in docs/platform-stm32l4-llext.md for a worked example.

# exein_dyn.llext has several sources; ELF_OBJECT supports only one.
choice LLEXT_BINARY_TYPE
	default LLEXT_TYPE_ELF_RELOCATABLE if RUNTIME_MONITOR_SYSCALL_HOOKS
endchoice

config ZA_LLEXT_MODULE_BUF_SIZE
	int "LLEXT module buffer size (bytes)"
	default 8192
	depends on RUNTIME_MONITOR_SYSCALL_HOOKS
	help
	  Size of the static buffer used to receive LLEXT module binaries
	  from flash or external sources before loading.

config ZA_LLEXT_FLASH_PERSIST
	bool "Persist LLEXT modules to flash"
	depends on RUNTIME_MONITOR_SYSCALL_HOOKS && FLASH_MAP
	help
	  When enabled, loaded LLEXT modules are read from (and can be
	  saved to) the storage_partition in flash, surviving reboots.

config ZA_LLEXT_AUTO_DOWNLOAD
	bool "Automatically download LLEXT module after monitor startup"
	depends on RUNTIME_MONITOR_SYSCALL_HOOKS
	default y
	help
	  Queue an HTTP LLEXT download after runtime_zephyr_start() completes.
	  Samples that prime storage_partition and only want the persisted module
	  loaded at boot can disable this.

endif # RUNTIME_MONITOR
